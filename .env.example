# ============================================================
# AI Meeting Intelligence System - Environment Variables
# ============================================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_meeting_intelligence
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Flask & JWT Configuration
FLASK_ENV=development
SECRET_KEY=generate_a_random_flask_secret_key_here
JWT_SECRET_KEY=generate_a_random_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Server & Network Configuration
BACKEND_PORT=5000
FRONTEND_URL=https://192.168.0.108:5173

# Email / SMTP Configuration (for Email Verification & Password Reset OTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER="AI Meeting Intelligence <your_email@gmail.com>"

# AI & LLM Configuration
WHISPER_MODEL=tiny
GEMINI_API_KEY=your_gemini_api_key_here
